{
  "name": "@ojfbot/daily-logger-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "shadow": "node --import tsx src/cli.ts",
    "type-check": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "postgres": "node --import tsx src/postgres-cli.ts",
    "test:postgres": "node --import tsx --test test/postgres/*.test.ts",
    "delivery": "node --import tsx src/delivery-cli.ts",
    "test:delivery": "node --import tsx --test test/delivery/*.test.ts"
  },
  "dependencies": {
    "@langchain/core": "1.3.4",
    "@langchain/langgraph": "1.7.5",
    "@langchain/langgraph-checkpoint": "1.2.3",
    "@langchain/langgraph-checkpoint-postgres": "1.1.4",
    "@langchain/langgraph-checkpoint-sqlite": "1.1.1",
    "@opentelemetry/api": "^1.10.0",
    "pg": "8.23.1",
    "pg-boss": "12.38.2"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "devDependencies": {
    "@types/pg": "8.23.1"
  }
}
