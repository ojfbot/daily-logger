{
  "name": "@ojfbot/daily-logger-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": [
    "src",
    "migrations",
    "dist"
  ],
  "scripts": {
    "shadow": "node --import tsx src/cli.ts",
    "type-check": "tsc --noEmit",
    "test": "node scripts/build-telemetry.mjs && node --import tsx --test test/*.test.ts",
    "build:telemetry": "node scripts/build-telemetry.mjs",
    "postgres": "node --import tsx src/postgres-cli.ts",
    "test:postgres": "node --import tsx --test test/postgres/*.test.ts",
    "delivery": "node --import tsx src/delivery-cli.ts",
    "test:delivery": "node --import tsx --test test/delivery/*.test.ts",
    "http": "node --import tsx src/http-cli.ts",
    "test:http": "node --import tsx --import ./test/http/faults.mjs --test test/http/*.test.ts"
  },
  "dependencies": {
    "@langchain/core": "1.3.4",
    "@langchain/langgraph": "1.7.5",
    "@langchain/langgraph-checkpoint": "1.2.3",
    "@langchain/langgraph-checkpoint-postgres": "1.1.4",
    "@langchain/langgraph-checkpoint-sqlite": "1.1.1",
    "@langfuse/otel": "6.1.1",
    "@langfuse/tracing": "6.1.1",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/core": "2.12.1",
    "@opentelemetry/exporter-trace-otlp-http": "0.223.2",
    "@opentelemetry/otlp-exporter-base": "0.223.2",
    "@opentelemetry/otlp-transformer": "0.223.2",
    "@opentelemetry/resources": "2.12.1",
    "@opentelemetry/sdk-trace-base": "2.12.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "fastify": "5.12.8",
    "pg": "8.23.1",
    "pg-boss": "12.38.2",
    "tsx": "4.21.0",
    "zod": "4.3.6"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "esbuild": "0.27.4"
  }
}
