{
  "name": "@ojfbot/daily-logger",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "generate": "tsx src/index.ts",
    "service:shadow": "node --import tsx apps/service/src/cli.ts",
    "test:service": "pnpm --filter @ojfbot/daily-logger-service test",
    "type-check:service": "pnpm --filter @ojfbot/daily-logger-service type-check",
    "type-check:journal": "pnpm --filter @ojfbot/daily-logger-journal type-check",
    "test:journal": "vitest run src/__tests__/activity-window.test.ts src/__tests__/should-skip-run.test.ts src/__tests__/schema.test.ts src/__tests__/journal-schema.test.ts src/__tests__/article-references.test.ts src/__tests__/article-markdown-normalization.test.ts src/__tests__/generate-article-provenance.test.ts src/__tests__/article-completion.test.ts src/__tests__/assembleBody.test.ts src/__tests__/renderArticle.test.ts src/__tests__/closing-options.test.ts src/__tests__/journal-render.test.ts src/__tests__/run-provenance.test.ts src/__tests__/toMarkdown.test.ts src/__tests__/model-time-output.test.ts src/__tests__/journal-serialization.test.ts",
    "lint:journal": "eslint 'packages/journal/src/**/*.ts' src/activity-window.ts src/should-skip-run.ts src/schema.ts src/action-item-schema.ts src/article-references.ts src/__tests__/journal-schema.test.ts src/normalize-article-markdown.ts src/render-article.ts src/article-title.ts src/recommendation-prose.ts src/__tests__/journal-render.test.ts src/run-provenance.ts src/__tests__/journal-serialization.test.ts",
    "generate:dry": "DRY_RUN=true tsx src/index.ts",
    "report": "tsx src/report.ts",
    "report:dry": "DRY_RUN=true tsx src/report.ts",
    "clean": "tsx src/clean.ts",
    "clean:dry": "DRY_RUN=true tsx src/clean.ts",
    "backfill": "tsx src/backfill-tags.ts",
    "backfill:refs": "tsx src/backfill-code-refs.ts",
    "backfill:times": "tsx src/backfill-times.ts",
    "build:api": "tsx src/build-api.ts",
    "check:action-intake": "tsx scripts/check-action-intake.ts",
    "actions:migrate": "tsx scripts/migrate-actions.ts",
    "actions:reconcile": "tsx scripts/reconcile-actions.ts",
    "actions:evidence:project": "tsx scripts/project-action-evidence.ts",
    "actions:evidence:respond": "tsx scripts/respond-action-evidence.ts",
    "actions:evidence:close": "tsx scripts/close-action-evidence.ts",
    "actions:check-review": "tsx scripts/check-action-review.ts",
    "dev": "tsx src/build-api.ts && cd packages/frontend && pnpm dev",
    "type-check": "tsc --noEmit",
    "lint": "eslint 'src/**/*.ts' 'packages/journal/src/**/*.ts'",
    "test": "vitest run",
    "test:browser": "pnpm build:api && playwright test",
    "test:watch": "vitest",
    "eval": "tsx evals/run.ts",
    "eval:test": "vitest run --config evals/vitest.config.ts",
    "actions:rebind": "tsx scripts/rebind-actions.ts",
    "check:action-size": "tsx scripts/check-action-size.ts",
    "check:shipment-times": "tsx scripts/check-shipment-time-coverage.ts",
    "service:postgres": "node --import tsx apps/service/src/postgres-cli.ts",
    "service:delivery": "node --import tsx apps/service/src/delivery-cli.ts",
    "test:service:delivery": "pnpm --filter @ojfbot/daily-logger-service test:delivery",
    "test:service:postgres": "pnpm --filter @ojfbot/daily-logger-service test:postgres",
    "service:http": "node --import tsx apps/service/src/http-cli.ts",
    "test:service:http": "pnpm --filter @ojfbot/daily-logger-service test:http",
    "test:service:exporter": "pnpm --filter @ojfbot/daily-logger-service test:exporter",
    "service:runtime:exporter": "node apps/service/runtime/exporter-smoke.mjs",
    "service:runtime:context": "node --import tsx apps/service/runtime/prepare-context.ts",
    "test:service:runtime": "node --import tsx --test apps/service/test/runtime/*.test.ts",
    "service:runtime:smoke": "node apps/service/runtime/smoke.mjs",
    "service:ingress:prepare": "node --import tsx apps/service/runtime/prepare-ingress.ts",
    "service:ingress:smoke": "node --import tsx apps/service/runtime/ingress-smoke.mjs",
    "service:artifact:export": "python3 apps/service/runtime/artifact.py export",
    "service:artifact:verify": "python3 apps/service/runtime/artifact.py verify",
    "test:service:artifact": "python3 -m unittest discover -s apps/service/test/runtime -p '*_test.py'",
    "test:service:restore": "node --test --test-concurrency=1 apps/service/test/restore/*.test.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.36.0",
    "@ojfbot/daily-logger-journal": "workspace:*",
    "@vercel/node": "^5.6.22",
    "parse5": "^7.3.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/marked": "^6.0.0",
    "@types/node": "^22.9.0",
    "esbuild": "^0.27.4",
    "eslint": "^10.1.0",
    "jsdom": "26.1.0",
    "marked": "^17.0.5",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.57.2",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@9.15.4"
}
